# Copie para .env; gere um segredo com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://pointmedia:local_only_change_me@127.0.0.1:5432/pointmedia?schema=public
TEST_DATABASE_URL=postgresql://pointmedia:local_only_change_me@127.0.0.1:5432/pointmedia_test?schema=public
# Somente para o Compose opcional em outras máquinas; o fluxo local não depende dele.
POSTGRES_PASSWORD=local_only_change_me
JWT_SECRET=
JWT_TTL_SECONDS=900
# Vazio no desenvolvimento; em produção, liste apenas os IPs do proxy controlado.
TRUSTED_PROXY_IPS=
# Obrigatório em produção: caminho absoluto privado/persistente, fora do frontend.
# Nos testes, deixe vazio para preservar o storage isolado.
RESUME_STORAGE_DIR=
# Prazo de participação escolhido por delegação do responsável; renovação voluntária.
TALENT_RETENTION_DAYS=180
# Somente para seed local. Defina senha forte com 12–128 caracteres.
SEED_PASSWORD=
# Opcional: pasta bin de um PostgreSQL 17 já instalado ou extraído do ZIP oficial.
# Se vazio, o Windows x64 utiliza os binários portáteis instalados pelo npm.
LOCAL_POSTGRES_BIN=
# Portas opcionais para E2E, separadas dos servidores de desenvolvimento.
E2E_API_PORT=33001
E2E_WEB_ORIGIN=http://localhost:55174
