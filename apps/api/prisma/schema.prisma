generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  name                    String                    @db.VarChar(120)
  email                   String                    @unique @db.VarChar(254)
  passwordHash            String
  phone                   String?                   @db.VarChar(30)
  jobTitle                String?                   @db.VarChar(120)
  role                    Role                      @default(CANDIDATE)
  active                  Boolean                   @default(true)
  passwordChangedAt       DateTime                  @default(now()) @db.Timestamptz(3)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  sessions                AuthSession[]
  auditLogs               AuditLog[]
  candidateProfile        CandidateProfile?
  resume                  ResumeFile?
  createdJobs             JobOpening[]
  applications            Application[]
  talentConsents          TalentConsent[]
  screeningConfigurations ScreeningConfiguration[]
  screeningRuns           ScreeningRun[]
  applicationStageEvents  ApplicationStageHistory[]
  recruiterNotes          RecruiterNote[]
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String   @db.VarChar(80)
  entityId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum ProfileField {
  LOCATION
  SENIORITY
  SALARY
  LINKEDIN
  PORTFOLIO
  SKILLS
  EXPERIENCE
  EDUCATION
}

model CandidateProfile {
  userId               String                   @id @db.Uuid
  headline             String                   @db.VarChar(120)
  location             String?                  @db.VarChar(160)
  seniority            Seniority?
  expectedSalary       Decimal?                 @db.Decimal(12, 2)
  linkedin             String?                  @db.VarChar(500)
  portfolio            String?                  @db.VarChar(500)
  about                String                   @db.VarChar(5000)
  notApplicable        ProfileField[]           @default([])
  recruitmentConsentAt DateTime?                @db.Timestamptz(3)
  version              Int                      @default(1)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills               CandidateSkill[]
  experience           ProfessionalExperience[]
  education            Education[]

  @@index([recruitmentConsentAt, updatedAt])
}

model Skill {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(80)
  normalizedName String           @unique @db.VarChar(80)
  candidates     CandidateSkill[]
}

model CandidateSkill {
  userId  String           @db.Uuid
  skillId String           @db.Uuid
  profile CandidateProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  skill   Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([userId, skillId])
}

model ProfessionalExperience {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  company       String           @db.VarChar(160)
  position      String           @db.VarChar(160)
  startedMonth  String           @db.VarChar(7)
  endedMonth    String?          @db.VarChar(7)
  description   String           @db.VarChar(2000)
  positionIndex Int
  profile       CandidateProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, positionIndex])
}

model Education {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  institution   String           @db.VarChar(160)
  course        String           @db.VarChar(160)
  startedYear   Int
  finishedYear  Int?
  positionIndex Int
  profile       CandidateProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, positionIndex])
}

model ResumeFile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  storageKey   String   @unique @db.Uuid
  originalName String   @db.VarChar(180)
  mimeType     String   @db.VarChar(100)
  size         Int
  sha256       String   @db.Char(64)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobOpening {
  id                      String                   @id @default(uuid()) @db.Uuid
  title                   String                   @db.VarChar(160)
  description             String                   @db.VarChar(12000)
  department              String?                  @db.VarChar(120)
  workMode                WorkMode
  seniority               Seniority?
  seniorityNotApplicable  Boolean
  location                String?                  @db.VarChar(160)
  locationNotApplicable   Boolean
  salaryMin               Decimal?                 @db.Decimal(12, 2)
  salaryMax               Decimal?                 @db.Decimal(12, 2)
  salaryNotApplicable     Boolean
  status                  JobStatus                @default(DRAFT)
  publishedAt             DateTime?                @db.Timestamptz(3)
  closesAt                DateTime                 @db.Timestamptz(3)
  version                 Int                      @default(1)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  createdById             String?                  @db.Uuid
  createdBy               User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  requirements            JobRequirement[]
  applications            Application[]
  screeningConfigurations ScreeningConfiguration[]
  screeningRuns           ScreeningRun[]

  @@index([status, closesAt, publishedAt])
  @@index([createdById])
}

model JobRequirement {
  id             String     @id @default(uuid()) @db.Uuid
  jobId          String     @db.Uuid
  name           String     @db.VarChar(80)
  normalizedName String     @db.VarChar(80)
  mandatory      Boolean
  positionIndex  Int
  job            JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, normalizedName])
  @@index([jobId, positionIndex])
}

enum ApplicationStatus {
  RECEIVED
  SCREENING
  SHORTLISTED
  INTERVIEW
  APPROVED
  REJECTED
}

model Application {
  id                   String                    @id @default(uuid()) @db.Uuid
  userId               String                    @db.Uuid
  jobId                String                    @db.Uuid
  status               ApplicationStatus         @default(RECEIVED)
  version              Int                       @default(1)
  submittedAt          DateTime                  @default(now()) @db.Timestamptz(3)
  authorizationVersion String                    @db.VarChar(40)
  profileVersion       Int
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                  JobOpening                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  screeningResults     ScreeningResult[]
  stageHistory         ApplicationStageHistory[]
  notes                RecruiterNote[]

  @@unique([userId, jobId])
  @@index([jobId, submittedAt])
  @@index([jobId, status, submittedAt])
  @@index([userId, submittedAt])
}

model ApplicationStageHistory {
  id             String             @id @default(uuid()) @db.Uuid
  applicationId  String             @db.Uuid
  fromStatus     ApplicationStatus?
  toStatus       ApplicationStatus
  version        Int
  publicMessage  String?            @db.VarChar(2000)
  internalReason String?            @db.VarChar(2000)
  actorId        String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor          User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([applicationId, version])
}

model RecruiterNote {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  body          String      @db.VarChar(2000)
  actorId       String?     @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model TalentConsent {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  consentVersion String    @db.VarChar(40)
  grantedAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([revokedAt, expiresAt])
}

model ScreeningConfiguration {
  id                   String         @id @default(uuid()) @db.Uuid
  jobId                String         @db.Uuid
  version              Int
  skillsWeight         Int
  seniorityWeight      Int
  salaryWeight         Int
  mandatorySkillsShare Int
  requireCompleteData  Boolean        @default(false)
  algorithmVersion     String         @db.VarChar(40)
  createdById          String?        @db.Uuid
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  job                  JobOpening     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy            User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs                 ScreeningRun[]

  @@unique([jobId, version])
}

model ScreeningRun {
  id              String                 @id @default(uuid()) @db.Uuid
  jobId           String                 @db.Uuid
  configurationId String                 @db.Uuid
  jobVersion      Int
  sequence        Int
  sourceHash      String                 @db.Char(64)
  createdById     String?                @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  job             JobOpening             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  configuration   ScreeningConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  createdBy       User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  results         ScreeningResult[]

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
}

model ScreeningResult {
  id             String       @id @default(uuid()) @db.Uuid
  runId          String       @db.Uuid
  applicationId  String       @db.Uuid
  profileVersion Int
  score          Decimal?     @db.Decimal(5, 2)
  coverage       Decimal      @db.Decimal(5, 2)
  reviewRequired Boolean
  evaluation     Json
  run            ScreeningRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([runId, applicationId])
  @@index([runId, score, coverage])
}
