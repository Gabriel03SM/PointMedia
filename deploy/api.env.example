# Exemplo para um proxy TLS e PostgreSQL na mesma máquina Linux.
# Gere as credenciais fora do histórico do shell; não versionar o arquivo preenchido.
NODE_ENV=production
PORT=3000
WEB_ORIGIN=https://talentos.example.invalid
DATABASE_URL=postgresql://pointmedia_runtime:REPLACE_ME@127.0.0.1:5432/pointmedia
JWT_SECRET=
JWT_TTL_SECONDS=900
TALENT_RETENTION_DAYS=180
TRUSTED_PROXY_IPS=127.0.0.1
RESUME_STORAGE_DIR=/var/lib/pointmedia/resumes
